<title>Rajbhar Restaurant</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#100d09;color:white;font-family:Arial}
header{text-align:center;padding:25px;background:#1c160c;border-bottom:2px solid gold}
h1{color:gold;font-size:32px}
nav{padding:15px;text-align:center}
nav a{color:gold;text-decoration:none;margin:10px}
.hero{text-align:center;padding:90px 15px}
.hero h2{font-size:35px;color:gold}
.hero p{margin:20px}
.btn{display:inline-block;background:gold;color:black;padding:13px 25px;text-decoration:none;border-radius:8px;font-weight:bold}
section{padding:35px 15px;text-align:center}
